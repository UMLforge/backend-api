# Sample settings for the UMLforge backend. Copy to `.env` (never commit .env) and fill in.
#   PythonAnywhere: cp .env.example .env   (read by wsgi_pythonanywhere.py)
#   Local shell:    set -a && . ./.env && set +a && uvicorn app.main:app --reload
# Keep comments on their own lines.

# --- Web ---------------------------------------------------------------------------------
# Frontend origin(s) allowed to call this API, comma-separated, no trailing slash.
CORS_ORIGINS=https://umlforge.github.io
# true only while debugging: puts internal error details in API responses.
EXPOSE_ERROR_DETAILS=false

# --- Database ----------------------------------------------------------------------------
# SQLite file, used when DATABASE_URL is empty. Created automatically on first start.
DB_PATH=/home/YOUR_PA_USERNAME/backend-api/data/umlforge.db
# Postgres instead (e.g. Neon). Needs a paid PythonAnywhere plan (free plan blocks DB connections).
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# --- AI service --------------------------------------------------------------------------
# "inprocess" = load the ai-service code from AI_SERVICE_PATH into this app (one web app on PythonAnywhere).
# Or a URL if ai-service runs elsewhere, e.g. http://localhost:8001 when running locally.
AI_SERVICE_URL=inprocess
AI_SERVICE_PATH=/home/YOUR_PA_USERNAME/ai-service
AI_TIMEOUT_SECONDS=60

# Read by the ai-service (only matters with AI_SERVICE_URL=inprocess). Pick one provider.
AI_PROVIDER=openai
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.1-8b-instant
AI_API_KEY=gsk_...
# Google Gemini:  AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  AI_MODEL=gemini-2.0-flash
# OpenRouter:     AI_BASE_URL=https://openrouter.ai/api/v1  AI_MODEL=<any model ending in :free>

# --- Published links ---------------------------------------------------------------------
SHARE_MAX_HOURS=168
SHARE_MAX_BYTES=1000000

# --- Rate limits ("requests/seconds" per visitor IP) -------------------------------------
RATE_LIMIT_PUBLISH=10/3600
RATE_LIMIT_VIEW=120/60
RATE_LIMIT_AI=20/600
# All visitors together, per day (protects a free AI key). "0/86400" turns it off.
RATE_LIMIT_AI_GLOBAL=500/86400
# Optional: share limits across workers via Upstash Redis.
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
